{
  "info": {
    "_postman_id": "c7a81e90-98fa-4b7d-b9e1-23456789abcd",
    "name": "Week 06 — Pagination, Filtering, Sorting (Tugas 6)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Default Pagination",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"]
        }
      }
    },
    {
      "name": "2. Custom Page and Per Page",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books?per_page=2&page=1",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"],
          "query": [
            { "key": "per_page", "value": "2" },
            { "key": "page", "value": "1" }
          ]
        }
      }
    },
    {
      "name": "3. Search Field Pertama (Title)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books?search=Clean",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"],
          "query": [{ "key": "search", "value": "Clean" }]
        }
      }
    },
    {
      "name": "4. Search Field Kedua (ISBN)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books?search=978013",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"],
          "query": [{ "key": "search", "value": "978013" }]
        }
      }
    },
    {
      "name": "5. Sorting Ascending",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books?sort=title&direction=asc",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"],
          "query": [
            { "key": "sort", "value": "title" },
            { "key": "direction", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "6. Sorting Descending",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books?sort=title&direction=desc",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"],
          "query": [
            { "key": "sort", "value": "title" },
            { "key": "direction", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "7. Kombinasi Pagination + Search + Sorting",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books?search=Code&sort=title&direction=asc&per_page=2&page=1",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"],
          "query": [
            { "key": "search", "value": "Code" },
            { "key": "sort", "value": "title" },
            { "key": "direction", "value": "asc" },
            { "key": "per_page", "value": "2" },
            { "key": "page", "value": "1" }
          ]
        }
      }
    },
    {
      "name": "8. Invalid Query Parameter (422 Error)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/books?sort=password",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books"],
          "query": [{ "key": "sort", "value": "password" }]
        }
      }
    }
  ]
}