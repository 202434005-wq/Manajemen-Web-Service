              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Custom header was received\", function () {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.headers[\"x-student-client\"]).to.eql(\"postman-week-2\");\r",
                  "});\r",
                  "```[span_16](start_span)[span_16](end_span)\r",
